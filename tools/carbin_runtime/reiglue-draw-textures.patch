+  // FH1 (carbin runtime check): the texture bound to a fetch constant as of the latest
+  // RequestTextures, for FORZA_DRAW_TEXTURES: false if none; the pack fingerprint is 0 when the
+  // texture was not fingerprinted (texture_dump or texture_replace off, GPU-written, ...).
+  bool Fh1BoundTextureInfo(uint32_t index, uint64_t& fingerprint, uint32_t& width, uint32_t& height,
+                           uint32_t& format, uint32_t& dimension) const {
+    const auto* binding = GetValidTextureBinding(index);
+    if (!binding || !binding->texture) return false;
+    fingerprint = binding->texture->pack_state().fingerprint;
+    width = binding->key.GetWidth();
+    height = binding->key.GetHeight();
+    format = uint32_t(binding->key.format);
+    dimension = uint32_t(binding->key.dimension);
+    return true;
+  }
